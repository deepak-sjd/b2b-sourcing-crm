# Copy this file to .env.local and fill in real values.
# .env.local is gitignored - never commit real secrets.
#
# NOTE: these are namespaced CRM_* deliberately, so they never collide with
# another project's DB_URL/DB_USERNAME/etc on the same machine (this bit us
# once already during setup).
#
# Ports are also dedicated to this project (5434 for Postgres, 8085 for the
# app) since this machine also runs "portfolio" (uses 5432) and "teacherOs"
# (uses 5433) - each project gets its own lane, nothing to remember or unset.
#
# IMPORTANT: plain `mvn spring-boot:run` does NOT read this file automatically -
# Spring Boot only sees real OS/terminal environment variables. Load it into
# your shell session first (see the PowerShell snippet below).

CRM_DB_URL=jdbc:postgresql://localhost:5434/doctutorials_crm
CRM_DB_USERNAME=crm_user
CRM_DB_PASSWORD=crm_password

# Generate a real one: openssl rand -base64 48
CRM_JWT_SECRET=change-this-to-a-long-random-secret-in-every-real-environment

CRM_CORS_ALLOWED_ORIGINS=http://localhost:3000

CRM_SERVER_PORT=8085